# Situation Room – Crontab
# Aktivieren: crontab /home/webuser/web/situation.schnueddels.de/public_html/cron/crontab.example
# Danach prüfen: crontab -l
# Logs: /home/webuser/web/situation.schnueddels.de/logs/

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
NODE=/usr/bin/node
BACKEND=/home/webuser/web/situation.schnueddels.de/public_html/backend
LOGS=/home/webuser/web/situation.schnueddels.de/logs

# --- Primärquellen ---
# USGS Erdbeben: alle 5 Minuten
*/5 * * * * $NODE $BACKEND/src/jobs/run-usgs.js >> $LOGS/usgs.log 2>&1

# GDACS Katastrophen: alle 10 Minuten
*/10 * * * * $NODE $BACKEND/src/jobs/run-gdacs.js >> $LOGS/gdacs.log 2>&1

# NOAA Tsunami: alle 5 Minuten
*/5 * * * * $NODE $BACKEND/src/jobs/run-noaa-tsunami.js >> $LOGS/noaa-tsunami.log 2>&1

# FIRMS Brände: alle 10 Minuten
*/10 * * * * $NODE $BACKEND/src/jobs/run-firms.js >> $LOGS/firms.log 2>&1

# OpenSky Luftverkehr: jede Minute
* * * * * $NODE $BACKEND/src/jobs/run-opensky.js >> $LOGS/opensky.log 2>&1

# ReliefWeb humanitäre Berichte: alle 30 Minuten
*/30 * * * * $NODE $BACKEND/src/jobs/run-reliefweb.js >> $LOGS/reliefweb.log 2>&1

# --- GDELT Attention-Layer (429-anfällig, alle 3 Stunden) ---
0 */3 * * * $NODE $BACKEND/src/jobs/run-gdelt.js >> $LOGS/gdelt.log 2>&1

# --- RSS Newsquellen: alle 30 Minuten ---
*/30 * * * * $NODE $BACKEND/src/jobs/run-bbc.js >> $LOGS/bbc.log 2>&1
*/30 * * * * $NODE $BACKEND/src/jobs/run-guardian.js >> $LOGS/guardian.log 2>&1
*/30 * * * * $NODE $BACKEND/src/jobs/run-aljazeera.js >> $LOGS/aljazeera.log 2>&1
*/30 * * * * $NODE $BACKEND/src/jobs/run-dw.js >> $LOGS/dw.log 2>&1
*/30 * * * * $NODE $BACKEND/src/jobs/run-france24.js >> $LOGS/france24.log 2>&1
*/30 * * * * $NODE $BACKEND/src/jobs/run-npr.js >> $LOGS/npr.log 2>&1
*/30 * * * * $NODE $BACKEND/src/jobs/run-skynews.js >> $LOGS/skynews.log 2>&1

# --- Wartung ---
# Projektlogs: bei 25 MB rotieren, fünf Generationen aufbewahren
15 3 * * * /home/webuser/web/situation.schnueddels.de/public_html/cron/rotate-logs.sh

# Cleanup alter Events: täglich um 03:30
30 3 * * * $NODE $BACKEND/src/jobs/cleanup.js >> $LOGS/cleanup.log 2>&1
