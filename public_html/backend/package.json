{
  "name": "situation-backend",
  "version": "1.0.0",
  "description": "Backend for Situation Dashboard - Real-time crisis monitoring",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/jobs/run-migrations.js",
    "db:baseline": "node src/jobs/run-migrations.js --baseline-existing",
    "job:usgs": "node src/jobs/run-usgs.js",
    "job:gdacs": "node src/jobs/run-gdacs.js",
    "job:gdelt": "node src/jobs/run-gdelt.js",
    "job:noaa-tsunami": "node src/jobs/run-noaa-tsunami.js",
    "job:firms": "node src/jobs/run-firms.js",
    "job:acled": "node src/jobs/run-acled.js",
    "job:reliefweb": "node src/jobs/run-reliefweb.js",
    "job:opensky": "node src/jobs/run-opensky.js",
    "job:bbc": "node src/jobs/run-bbc.js",
    "job:guardian": "node src/jobs/run-guardian.js",
    "job:aljazeera": "node src/jobs/run-aljazeera.js",
    "job:dw": "node src/jobs/run-dw.js",
    "job:france24": "node src/jobs/run-france24.js",
    "job:npr": "node src/jobs/run-npr.js",
    "job:skynews": "node src/jobs/run-skynews.js",
    "job:cleanup": "node src/jobs/cleanup.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "mysql2": "^3.6.0",
    "node-cron": "^3.0.0",
    "winston": "^3.10.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
